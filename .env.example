# LG CUT — Frontend environment variables
# Copy this file to `.env` for local development, and set the same variable
# in your host's dashboard (Netlify OR Vercel → Environment variables) for
# production.

# Base URL of the LG CUT backend API
# Local:      http://localhost:3001/api
# Production: https://backend-lgcut.onrender.com/api
VITE_API_URL=http://localhost:3001/api

# NOTE: Booking notifications (email + Telegram) are sent by the BACKEND, not
# the frontend. Configure FORMSPREE_ENDPOINT / TELEGRAM_* in backend/.env.
